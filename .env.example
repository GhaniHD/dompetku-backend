DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=myfulus
DB_PASSWORD=
DB_NAME=myfulus
DB_SSLMODE=disable

PORT=8090
# Isi 127.0.0.1 di VPS agar server hanya bisa dijangkau lewat Caddy
BIND_ADDR=0.0.0.0
GIN_MODE=release
# Minimal 32 karakter. Server menolak start kalau kurang. Jangan diganti setelah produksi jalan.
JWT_SECRET=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Email yang otomatis menjadi admin (pisahkan dengan koma)
ADMIN_EMAILS=emailanda@gmail.com
ADMIN_WHATSAPP=

# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,https://myfulus.my.id,https://www.myfulus.my.id
TRUSTED_PROXIES=127.0.0.1,::1

# Email (Brevo). SMTP_HOST kosong = email mati dan verifikasi tidak diwajibkan.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyFulus <noreply@myfulus.my.id>
MAIL_REPLY_TO=
APP_URL=https://myfulus.my.id
API_URL=https://api.myfulus.my.id
BREVO_WEBHOOK_SECRET=
EMAIL_DOMAIN_CHECK=true

# Hanya untuk integration test. Database ini DIKOSONGKAN setiap test jalan,
# jadi namanya wajib mengandung kata "test" dan tidak boleh database produksi.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
TEST_DB_NAME=dompetku_ci_test
